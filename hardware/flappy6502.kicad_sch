  (text "J1 pins: 1 SDA 2 RST 3 TE 4 CS 5 SCL 6 DC 7 EN 8 GND 9 VCC"
    (at 440 140 0)
    (effects (font (size 1.5 1.5)) (justify left))
    (uuid b9a0c8db-9707-5876-b4a5-55f3e8a368ef)
  )
  (text "flappy6502 - R6502 + 28C64 + 32K SRAM + 74LS logic -> ST7789 LCD (bit-banged SPI)"
    (at 20 15 0)
    (effects (font (size 2.5 2.5) bold) (justify left))
    (uuid 18cf120e-0427-5b2a-b270-570b83ae3dd4)
  )
  (text "Memory map: RAM $0000-$7FFF, LCD latch $8000 (bit0 SDA, bit1 SCL, bit2 DC, bit3 CS), ROM $E000-$FFFF"
    (at 20 22 0)
    (effects (font (size 1.5 1.5)) (justify left))
    (uuid 85a7cb3c-88d3-53fc-bba4-8015ece6da0d)
  )
  (text "CPU clock PHI0 = U6 QC (1.25 MHz) or QD pin 11 (625 kHz). C4 sits at U5 pin 2."
    (at 20 27 0)
    (effects (font (size 1.5 1.5)) (justify left))
    (uuid 466f01d6-92a5-5499-9b2a-57f2f6ec43df)
  )
  (text "LCD rule: never feed the module 5 V; RST and EN come from U7 (low during reset)."
    (at 20 32 0)
    (effects (font (size 1.5 1.5)) (justify left))
    (uuid 4696e7ab-0b37-5a72-825f-5d52caacd0e0)
  )
  (text "Decoupling: C9-C15 100n at each IC (U1-U7); C8 10u at the CPU."
    (at 45 345 0)
    (effects (font (size 1.5 1.5)) (justify left))
    (uuid 438f7ece-f7fe-5731-a728-f4fab444c718)
  )

  (label "GND" (at 58.42 69.85000000000001 180)
    (effects (font (size 1.0 1.0)))
    (uuid 9ac5e44c-ec14-5ec1-bc5d-c946462505f8)
  )
