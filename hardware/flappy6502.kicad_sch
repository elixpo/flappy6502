  (uuid 15d76a9e-b5af-590a-bac5-ed1a7b569c80)

  (paper "A3")

  (title_block
    (title "flappy6502 - R6502 Flappy Bird breadboard computer")
    (date "2026-10-27")
    (rev "3")
    (comment 1 "Map: RAM $0000-7FFF, LCD latch $8000 (b0 SDA b1 SCL b2 DC b3 CS), ROM $E000-FFFF")
    (comment 2 "Clock: 10 MHz crystal on U7 -> U6 /8 = 1.25 MHz PHI0 (U6 pin 11 = 625 kHz)")
    (comment 3 "LCD never fed 5 V (RST/EN from U7). C4 10p at U5 pin 2. C9-C15: 100n per IC")
    (comment 4 "All connections drawn; risers at left join rows; dots = junctions. roms/flappy_bb.bin")
  )

